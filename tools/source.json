      "sections": [
        {
          "id": "ch-2b-core",
          "name": "基本算法",
          "topics": [
            {
              "id": "basic",
              "name": "模拟",
              "desc": "照着题意一步步实现，练手感、练细节。输入输出格式、边界条件、多组数据都要看仔细；难一点的是把规则本身写清楚。",
              "note": "https://cuberxl.github.io/Coders-Note/2B-基本算法/",
              "problems": [
                "P1001",
                "P1046",
                "P1047",
